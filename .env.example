APP_NAME="Chem Rank"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Bangkok

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/storage/database.sqlite

# For MySQL hosting:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=chem_rank
# DB_USERNAME=chem_rank_user
# DB_PASSWORD=change-me
# DB_CHARSET=utf8mb4

SESSION_NAME=chem_rank_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax

LOGIN_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900

